{
  "$schema": "../../schemas/analysis-model.schema.json",
  "system": {
    "id": "library-lending",
    "name": "Library Lending Information System",
    "goal": "Record and control book borrowing with a traceable approval result.",
    "boundary": "The system validates readers and books, creates loans, and returns results. Readers remain outside the system.",
    "exclusions": ["Online payment", "Inter-library loan"],
    "notationProfile": {
      "tfdEdgeLabels": "forbidden",
      "externalEntityShape": "circle"
    }
  },
  "requirements": [
    { "id": "R-001", "statement": "An eligible reader can submit a borrowing request.", "priority": "must", "status": "accepted" },
    { "id": "R-002", "statement": "The system records an approved loan and returns a result.", "priority": "must", "status": "accepted" }
  ],
  "actors": [
    {
      "id": "S1",
      "cardId": "E-01",
      "name": "Reader",
      "type": "person",
      "boundaryDescription": "A library user who submits borrowing requests and receives results.",
      "incomingFlowIds": ["D-005"],
      "outgoingFlowIds": ["D-001"]
    }
  ],
  "businessFlows": [
    {
      "id": "B-001",
      "name": "Borrow a book",
      "trigger": "An eligible reader submits a borrowing request.",
      "outcome": "The system records an approved loan or returns a rejection result.",
      "requirementIds": ["R-001", "R-002"]
    }
  ],
  "processes": [
    {
      "id": "P0",
      "cardId": "P-00",
      "name": "Library Lending Information System",
      "level": 0,
      "inputFlowIds": ["D-001"],
      "outputFlowIds": ["D-005"],
      "readStoreIds": [],
      "writeStoreIds": [],
      "trigger": "A reader submits a borrowing request.",
      "logic": "Coordinate request validation and loan registration.",
      "exceptions": ["Invalid request"],
      "frequency": "On demand"
    },
    {
      "id": "P1",
      "cardId": "P-01",
      "name": "Validate borrowing request",
      "level": 1,
      "inputFlowIds": ["D-001"],
      "outputFlowIds": ["D-002"],
      "readStoreIds": [],
      "writeStoreIds": [],
      "trigger": "A borrowing request is received.",
      "logic": "Validate reader and book identifiers and decide whether the request can proceed.",
      "exceptions": ["Reader is ineligible", "Book is unavailable"],
      "frequency": "Once per request"
    },
    {
      "id": "P2",
      "cardId": "P-02",
      "name": "Create loan record",
      "level": 1,
      "inputFlowIds": ["D-002", "D-004"],
      "outputFlowIds": ["D-003", "D-005"],
      "readStoreIds": ["F1"],
      "writeStoreIds": ["F1"],
      "trigger": "A borrowing request is approved.",
      "logic": "Check loan history, create a loan record, and return the result.",
      "exceptions": ["A conflicting loan already exists"],
      "frequency": "Once per approved request"
    }
  ],
  "diagrams": [
    {
      "id": "TFD-B001",
      "type": "tfd",
      "level": 0,
      "businessFlowId": "B-001",
      "processIds": ["P1", "P2"],
      "storeIds": ["F1"],
      "boundaryFlows": [
        { "flowId": "D-001", "endpointId": "S1", "direction": "input", "processId": "P1" },
        { "flowId": "D-005", "endpointId": "S1", "direction": "output", "processId": "P2" }
      ],
