      "storeIds": ["F1"],
      "boundaryFlows": [
        { "flowId": "D-001", "endpointId": "S1", "direction": "input", "processId": "P1" },
        { "flowId": "D-005", "endpointId": "S1", "direction": "output", "processId": "P2" }
      ],
      "processBoundaries": [
        {
          "processId": "P1",
          "boundaryFlows": [
            { "flowId": "D-001", "endpointId": "S1", "direction": "input" },
            { "flowId": "D-002", "endpointId": "P2", "direction": "output" }
          ]
        },
        {
          "processId": "P2",
          "boundaryFlows": [
            { "flowId": "D-002", "endpointId": "P1", "direction": "input" },
            { "flowId": "D-003", "endpointId": "F1", "direction": "output" },
            { "flowId": "D-004", "endpointId": "F1", "direction": "input" },
            { "flowId": "D-005", "endpointId": "S1", "direction": "output" }
          ]
        }
      ]
    }
  ],
  "dataFlows": [
    { "cardId": "DF-01", "id": "D-001", "name": "Borrowing request", "description": "Reader and book identifiers submitted for borrowing.", "source": "S1", "target": "P1", "structureIds": ["DS-001"], "frequency": "On demand" },
    { "cardId": "DF-02", "id": "D-002", "name": "Approved request", "description": "A validated request passed to loan registration.", "source": "P1", "target": "P2", "structureIds": ["DS-001"], "frequency": "Per approved request" },
    { "cardId": "DF-03", "id": "D-003", "name": "Loan record", "description": "A new persistent loan record.", "source": "P2", "target": "F1", "structureIds": ["DS-002"], "frequency": "Per approved request" },
    { "cardId": "DF-04", "id": "D-004", "name": "Loan history", "description": "Existing loan records used for conflict checks.", "source": "F1", "target": "P2", "structureIds": ["DS-002"], "frequency": "Per approved request" },
    { "cardId": "DF-05", "id": "D-005", "name": "Borrowing result", "description": "Approval or rejection result returned to the reader.", "source": "P2", "target": "S1", "structureIds": ["DS-003"], "frequency": "Per request" }
  ],
  "dataStores": [
    {
      "id": "F1",
      "cardId": "ST-01",
      "name": "Loan records",
      "description": "Persistent records of approved borrowing transactions and their result state.",
      "structureIds": ["DS-002"],
      "keyItemIds": ["I-003"],
      "readProcessIds": ["P2"],
      "writeProcessIds": ["P2"],
      "retention": "Retained for the configured audit period"
    }
  ],
  "dataStructures": [
    { "cardId": "STR-01", "id": "DS-001", "name": "Borrowing request", "description": "Identifiers needed to request a loan.", "itemIds": ["I-001", "I-002"] },
    { "cardId": "STR-02", "id": "DS-002", "name": "Loan record", "description": "Persistent loan identity, participants, and result state.", "itemIds": ["I-001", "I-002", "I-003", "I-004"] },
    { "cardId": "STR-03", "id": "DS-003", "name": "Borrowing result", "description": "Result returned after processing.", "itemIds": ["I-003", "I-004"] }
  ],
  "dataItems": [
    { "cardId": "DI-01", "id": "I-001", "name": "Reader identifier", "aliases": ["Reader ID"], "description": "Stable identifier of the borrowing reader.", "logicalType": "identifier", "representation": "Opaque identifier; physical type is selected during realization.", "valueDomain": "Identifiers of known readers", "required": true, "sensitive": false, "constraints": ["Must reference a known reader"] },
    { "cardId": "DI-02", "id": "I-002", "name": "Book identifier", "aliases": ["Book ID"], "description": "Stable identifier of the requested book.", "logicalType": "identifier", "representation": "Opaque identifier; physical type is selected during realization.", "valueDomain": "Identifiers of known books", "required": true, "sensitive": false, "constraints": ["Must reference a known book"] },
    { "cardId": "DI-03", "id": "I-003", "name": "Loan identifier", "aliases": ["Loan ID"], "description": "Unique identifier of the loan record.", "logicalType": "identifier", "representation": "Opaque identifier; physical type is selected during realization.", "valueDomain": "Unique loan identifiers", "required": true, "sensitive": false, "constraints": ["Unique"] },
    { "cardId": "DI-04", "id": "I-004", "name": "Result code", "aliases": ["Loan result"], "description": "Persisted result of the borrowing request.", "logicalType": "code", "representation": "Integer code defined by STATE-LOAN.", "valueDomain": "0 = Rejected; 1 = Approved", "stateId": "STATE-LOAN", "required": true, "sensitive": false, "constraints": ["Must use STATE-LOAN"] }
  ],
  "states": [
    {
      "id": "STATE-LOAN",
      "name": "Loan result",
      "values": [
        { "code": 0, "meaning": "Rejected" },
        { "code": 1, "meaning": "Approved" }
      ],
      "transitions": [
        { "from": 0, "to": 1, "trigger": "Request is approved before persistence" }
      ]
    }
  ],
  "mappings": {
